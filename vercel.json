    { "source": "/xircle/commerce/:path*", "destination": "/xircle2/commerce/:path*", "permanent": false },
    { "source": "/xircle/academy/:path*", "destination": "/xircle2/academy/:path*", "permanent": false },
    { "source": "/xircle/source/:path*", "destination": "/xircle2/source/:path*", "permanent": false },
    { "source": "/xircle/_shared/experience.css", "destination": "/xircle2/_shared/experience.css", "permanent": false },
    { "source": "/xircle/_shared/story.css", "destination": "/xircle2/_shared/story.css", "permanent": false },
    { "source": "/xircle/_shared/story.js", "destination": "/xircle2/_shared/story.js", "permanent": false },
    { "source": "/xircle/assets/source/:path*", "destination": "/xircle2/assets/source/:path*", "permanent": false },
    { "source": "/xircle/assets/generated/:path*", "destination": "/xircle2/assets/generated/:path*", "permanent": false },
    { "source": "/xircle/assets/campaign/:path*", "destination": "/xircle2/assets/campaign/:path*", "permanent": false },

    { "source": "/app", "destination": "/xircle2/app/", "permanent": false },
    { "source": "/app/", "destination": "/xircle2/app/", "permanent": false },
    { "source": "/routinex", "destination": "/xircle/routinex/", "permanent": false },
    { "source": "/routinex/", "destination": "/xircle/routinex/", "permanent": false },
    { "source": "/habix", "destination": "/xircle2/habix/", "permanent": false },
    { "source": "/habix/", "destination": "/xircle2/habix/", "permanent": false },
    { "source": "/ecosystem", "destination": "/xircle2/ecosystem/", "permanent": false },
    { "source": "/ecosystem/", "destination": "/xircle2/ecosystem/", "permanent": false },
    { "source": "/xvisor", "destination": "/xircle2/xvisor/", "permanent": false },
    { "source": "/xvisor/", "destination": "/xircle2/xvisor/", "permanent": false },
    { "source": "/xos", "destination": "/xircle2/xos/", "permanent": false },
    { "source": "/xos/", "destination": "/xircle2/xos/", "permanent": false },
    { "source": "/commerce", "destination": "/xircle2/commerce/", "permanent": false },
    { "source": "/commerce/", "destination": "/xircle2/commerce/", "permanent": false },
    { "source": "/academy", "destination": "/xircle2/academy/", "permanent": false },
    { "source": "/academy/", "destination": "/xircle2/academy/", "permanent": false },

    { "source": "/kickstart/", "destination": "/kickstarter/", "permanent": true },
    { "source": "/core7/assets/card-back-core7.png", "destination": "/core7/assets/card-back-core7.webp", "permanent": true },
    { "source": "/core7/assets/core7-rules-overview.png", "destination": "/core7/assets/core7-rules-overview.webp", "permanent": true }
  ],
  "headers": [
    {
      "source": "/core7/assets/(card-back-core7|core7-rules-overview).webp",
      "headers": [
        { "key": "Content-Type", "value": "image/webp" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/kickstarter/",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter.js",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter-distilled.js",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter-distilled-legacy.js",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter.css",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter-v2.css",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter-failsafe.css",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    },
    {
      "source": "/kickstarter/kickstarter-static-story.css",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?path=:path*" }
  ]
}
