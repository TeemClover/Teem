    { "source": "/xircle/hardware", "destination": "/xircle/hardware/", "permanent": false },
    { "source": "/xircle/products", "destination": "/xircle/products/", "permanent": false },
    { "source": "/xircle/care", "destination": "/xircle/care/", "permanent": false },
    { "source": "/xircle/opportunity", "destination": "/xircle/opportunity/", "permanent": false },
    { "source": "/xircle/learn", "destination": "/xircle/learn/", "permanent": false },

    { "source": "/xircle2", "destination": "/xircle2/", "permanent": false },
    { "source": "/xircle/app/:path*", "destination": "/xircle2/app/:path*", "permanent": false },
    { "source": "/xircle/habix/:path*", "destination": "/xircle2/habix/:path*", "permanent": false },
    { "source": "/xircle/ecosystem/:path*", "destination": "/xircle2/ecosystem/:path*", "permanent": false },
