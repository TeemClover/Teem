{
  "redirects": [
    {
      "source": "/kickstart/",
      "destination": "/kickstarter/",
      "permanent": true
    },
    {
      "source": "/core7/assets/card-back-core7.png",
      "destination": "/core7/assets/card-back-core7.webp",
      "permanent": true
    },
    {
      "source": "/core7/assets/core7-rules-overview.png",
      "destination": "/core7/assets/core7-rules-overview.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/core7/assets/(card-back-core7|core7-rules-overview).webp",
      "headers": [
        { "key": "Content-Type", "value": "image/webp" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/kickstarter/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter-distilled.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter-distilled-legacy.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter-v2.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter-failsafe.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kickstarter/kickstarter-static-story.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
