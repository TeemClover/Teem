# Reuse existing DATABASE_URL and CRON_SECRET. Never commit actual health dates or secrets.
# Optional password override, otherwise BACKOFFICE_ADMIN_KEY / MEDIRAL_ADMIN_KEY / MEET_ADMIN_KEY.
EGGCYCLE_ADMIN_KEY=
# Optional dedicated private Telegram destination. Fallback: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID.
EGGCYCLE_TELEGRAM_BOT_TOKEN=
EGGCYCLE_TELEGRAM_CHAT_ID=
EGGCYCLE_APP_URL=https://www.myclover.com/eggcycle/
# ISO date: set privately before the first authenticated load, or use the first-run form.
EGGCYCLE_INITIAL_PERIOD_START=
