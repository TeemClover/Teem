<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="800" height="1200" viewBox="0 0 800 1200" role="img" aria-labelledby="title desc">
  <title id="title">CORE7 visual rules overview</title>
  <desc id="desc">The original minimal CORE7 rule graphic. Red beats Green, Green beats Blue, Blue beats Red, Gray blocks, the loser discards one additional card, three round wins win the game, and Final Gray loses. The final Red and Gray cards are shown in the corrected order with Gray on the losing side.</desc>
  <defs>
    <clipPath id="left" clipPathUnits="userSpaceOnUse"><rect x="530" y="800" width="95" height="185"/></clipPath>
    <clipPath id="right" clipPathUnits="userSpaceOnUse"><rect x="665" y="800" width="95" height="185"/></clipPath>
  </defs>
  <image href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" xlink:href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" x="0" y="0" width="800" height="1200" preserveAspectRatio="none"/>
  <g clip-path="url(#left)">
    <image href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" xlink:href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" x="-135" y="0" width="800" height="1200" preserveAspectRatio="none"/>
  </g>
  <g clip-path="url(#right)">
    <image href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" xlink:href="https://raw.githubusercontent.com/TeemClover/Teem/0d20c3730bd092852dc69fefb9f84bf95a50f271/core7/assets/core7-rules-overview.png" x="135" y="0" width="800" height="1200" preserveAspectRatio="none"/>
  </g>
</svg>
