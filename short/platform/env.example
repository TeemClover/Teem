# Configure these privately in Vercel. Never add real values to Git.
TORNTOR_MODE=demo
TORNTOR_ORIGIN=https://www.myclover.com
TORNTOR_DATABASE_URL=
# Supabase Auth public URL and public anon/publishable key. DB can be separate Neon.
TORNTOR_AUTH_URL=
TORNTOR_AUTH_PUBLIC_KEY=
TORNTOR_OMISE_PUBLIC_KEY=
TORNTOR_OMISE_SECRET_KEY=
TORNTOR_LIVE_ENABLED=false
# Only true after existing paid catalog files have moved out of public static hosting.
TORNTOR_CONTENT_PROTECTED=false
# Private R2 / S3 compatible bucket; never enable anonymous public access.
TORNTOR_S3_ENDPOINT=
TORNTOR_S3_BUCKET=
TORNTOR_S3_REGION=auto
TORNTOR_S3_ACCESS_KEY=
TORNTOR_S3_SECRET_KEY=
