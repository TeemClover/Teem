# Empire Command Center / Keen / Capture backoffice
# Optional production override. If omitted, the built-in private access code is used.
BACKOFFICE_ADMIN_KEY=

# Discord OAuth — add the callback URL to the Discord Developer Portal as well.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://www.myclover.com/api/discord/callback
DISCORD_GUILD_ID=

# Vercel Blob — เก็บภาพที่แนบในแชท XTY และปกฉากจบ
# ไม่ตั้งค่า = แนบภาพไม่ได้ (ระบบตอบ IMAGE_UPLOAD_NOT_CONFIGURED) ส่วนอื่นทำงานปกติ
BLOB_READ_WRITE_TOKEN=

# XTY Living PET — shared Groq brain for scheduled + direct pet turns
# XTY_PET_AI=on และ GROQ_API_KEY ต้องมีทั้งคู่จึงจะให้ PET คิด/ตอบได้
XTY_PET_AI=on
GROQ_API_KEY=

# Optional vision pre-pass for public image URLs found in Party Log
XTY_PET_VISION=off

# Vercel Cron secret for GET /api/xty-pet
# ตั้งเป็นค่าสุ่มยาว ๆ ใน Production; Vercel Cron จะส่งเป็น Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Meet Teem & Ako — /meet booking intake
# MEET_ADMIN_KEY เปิดหน้า /meet/admin/ และ GET/PATCH /api/meet
# ไม่ตั้ง = หน้าคิวนัดเข้าไม่ได้ (ตอบ 503) แต่ฟอร์มยังรับนัดและบันทึกลง DB ตามปกติ
MEET_ADMIN_KEY=

# แจ้งเตือนนัดใหม่ — ตั้งช่องไหนก็ได้ ตั้งทั้งคู่ก็ได้ ไม่ตั้งเลยก็ยังบันทึกนัดครบ
# LINE Messaging API: Channel access token (long-lived) + userId ของคนที่จะรับแจ้งเตือน
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_USER_ID=

# Telegram: token จาก @BotFather + chat id ที่จะให้ยิงเข้า
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
