# Required: isolated TeamBook database. Never reuse another product's URL.
TEAMBOOK_DATABASE_URL=

# Required for the dedicated Private Blob store and member-gated image reads
BLOB_READ_WRITE_TOKEN=

# Required for scheduled PET wakes
CRON_SECRET=

# Required for Groq PET replies
GROQ_API_KEY=
TEAMBOOK_PET_AI=on
TEAMBOOK_PET_VISION=on
TEAMBOOK_PET_TEXT_MODEL=openai/gpt-oss-20b
TEAMBOOK_PET_VISION_MODEL=qwen/qwen3.6-27b
TEAMBOOK_PET_WAKE_CONCURRENCY=12

# Optional: Ending Art image adapter.
# TeamBook sends {prompt,aspectRatio,width,height,n,responseFormat,model} and
# accepts imageBase64 / b64_json / data[0].b64_json / images[0].base64 or URL.
# If this is unset, the Evidence Brain + Art Brief still work and TeamBook
# deliberately does not substitute random imagery.
TEAMBOOK_ENDING_IMAGE_ENDPOINT=
TEAMBOOK_ENDING_IMAGE_TOKEN=
TEAMBOOK_ENDING_IMAGE_MODEL=

# Required for email OTP sign-in
RESEND_API_KEY=
TEAMBOOK_FROM_EMAIL=

# TeamBook admin
TEAMBOOK_ADMIN_PASSWORD=

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
