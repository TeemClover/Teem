{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/teambook-pet",
      "schedule": "27 5,11,17,23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/teambook",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/teambook/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/start/",
      "permanent": false
    },
    {
      "source": "/read",
      "destination": "/read/",
      "permanent": false
    },
    {
      "source": "/new",
      "destination": "/new/",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "/join/",
      "permanent": false
    },
    {
      "source": "/p",
      "destination": "/p/",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/profile/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/teambook/party/:code/finish",
      "destination": "/api/teambook-party-finish?code=:code"
    },
    {
      "source": "/api/teambook/:path*",
      "destination": "/api/teambook?path=:path*"
    }
  ]
}
