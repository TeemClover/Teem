{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "alias": [
    "teambook.me",
    "www.teambook.me"
  ],
  "crons": [
    {
      "path": "/api/teambook-pet-compat",
      "schedule": "27 5,11,17,23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/xircle",
      "destination": "https://www.myclover.com/xircle/",
      "permanent": false
    },
    {
      "source": "/xircle/",
      "destination": "https://www.myclover.com/xircle/",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/start/",
      "permanent": false
    },
    {
      "source": "/read",
      "destination": "/read/",
      "permanent": false
    },
    {
      "source": "/new",
      "destination": "/new/",
      "permanent": false
    },
    {
      "source": "/join",
      "destination": "/join/",
      "permanent": false
    },
    {
      "source": "/p",
      "destination": "/p/",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/profile/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    },
    {
      "source": "/api/teambook-pet",
      "destination": "/api/teambook-pet-compat"
    },
    {
      "source": "/api/teambook/party/:code/finish",
      "destination": "/api/teambook-party-finish?code=:code"
    },
    {
      "source": "/api/teambook/party/:code/image/:seq",
      "destination": "/api/teambook-media?code=:code&seq=:seq"
    },
    {
      "source": "/api/teambook/party/:code/cover",
      "destination": "/api/teambook-media?code=:code&cover=1"
    },
    {
      "source": "/api/teambook/:path*",
      "destination": "/api/teambook?path=:path*"
    }
  ]
}
