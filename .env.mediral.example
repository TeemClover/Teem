# Server-only. Add actual values in Vercel Project Settings, never in Git or chat.
MEDIRAL_MODE=paused
MEDIRAL_LINE_SECRET=
MEDIRAL_LINE_ACCESS_TOKEN=
# Messaging API bot user ID, U followed by 32 lowercase hex digits; NOT basic ID @...
MEDIRAL_LINE_BOT_ID=
# Dedicated admin key, at least 24 characters; generate randomly.
MEDIRAL_ADMIN_KEY=
# Optional: absent means human slip review, never automatic paid.
MEDIRAL_EASYSLIP_KEY=
# Reuse existing DATABASE_URL and CRON_SECRET; do not rotate other apps' values.
# DATABASE_URL=
# CRON_SECRET=
