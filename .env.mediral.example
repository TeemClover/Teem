# Server-only. Add actual values in Vercel Project Settings, never in Git or chat.
MEDIRAL_MODE=paused
# Enable the myClover house menu, topic routing and explicit news preferences.
MEDIRAL_SHARED_OA=1
MEDIRAL_OWNER_LINE_ID=
MEDIRAL_LINE_BASIC_ID=
MEDIRAL_NATIVE_GREETING=1
MEDIRAL_LINE_SECRET=
MEDIRAL_LINE_ACCESS_TOKEN=
# Messaging API bot user ID, U followed by 32 lowercase hex digits; NOT basic ID @...
MEDIRAL_LINE_BOT_ID=
# Owner login password. Short passwords require a strong server session/LINE secret.
MEDIRAL_ADMIN_KEY=
# Optional independent random signing secret (24+ chars); existing LINE secret is fallback.
MEDIRAL_ADMIN_SESSION_SECRET=
# Optional: absent means human slip review, never automatic paid.
MEDIRAL_EASYSLIP_KEY=
# Reuse existing DATABASE_URL and CRON_SECRET; do not rotate other apps' values.
# DATABASE_URL=
# CRON_SECRET=
