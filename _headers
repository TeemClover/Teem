# Cloudflare Pages — ส่วนหัวของแต่ละเส้นทาง

# ของเก่าที่ย้ายมาเก็บไว้ — ยังเปิดด้วย URL ตรงได้ แต่ไม่ให้ Google เก็บไปขึ้นผลค้นหา
/archive/*
  X-Robots-Tag: noindex, nofollow

# หลังบ้านของ club — ไม่ให้ขึ้นผลค้นหาเช่นกัน
/club/lab/*
  X-Robots-Tag: noindex, nofollow

# Walkthrough — เปิดให้คนที่อ่านการ์ตูนจบแล้วเท่านั้น ไม่ควรโผล่ในผลค้นหา
/walkthrough/*
  X-Robots-Tag: noindex, nofollow

# CORE7 admin — ไม่ให้ขึ้นผลค้นหา
/core7/admin/*
  X-Robots-Tag: noindex, nofollow

# First Class admin — private control room
/first-class/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# หน้าสถิติทั้งหมด — ไม่ให้ขึ้นผลค้นหา (/stat/* ล็อกด้วยรหัสผ่านที่ขอบอีกชั้น)
/stat/*
  X-Robots-Tag: noindex, nofollow, noarchive

/collection/stat/*
  X-Robots-Tag: noindex, nofollow, noarchive

/core7/stat/*
  X-Robots-Tag: noindex, nofollow, noarchive

/core7/collection/stat/*
  X-Robots-Tag: noindex, nofollow, noarchive

# HALO / Calling private campaign concept — shared only by direct link + access code
/calling/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
