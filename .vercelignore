# Cloudflare Pages Functions — เป็นโค้ดฝั่งเซิร์ฟเวอร์ของ Cloudflare เท่านั้น
# ถ้าปล่อยขึ้น Vercel มันจะถูกเสิร์ฟเป็นไฟล์ธรรมดาให้คนเปิดอ่านซอร์สได้
functions/

# X-VISOR developer fixtures and review reports are not public site assets.
tests/xvisor/
docs/xvisor/

# Front Door release ships the experience, not local fixture servers or QA sources.
tests/frontdoor/
tests/teambook/compass-entry.e2e.mjs
docs/frontdoor/
tests/ako/
tests/stat/
docs/ako/
core7/tests/
frontdoor/*.test.mjs
assets/front-door/*.test.mjs

# Course authentication tests and local adapters are development-only.
tests/course/

# Shelf fixtures contain local-only admin helpers and are never public assets.
tests/shelf/
api/_lib/shelf-memory.js
api/_lib/shelf-*.test.mjs

# AI Sauce receipt/offer QA runs locally; no test fixtures are public assets.
api/_lib/ai-source.test.mjs
tests/ai-source/

# School QA and local tools never ship as static files.
learn/tests/
api/_lib/learn*.test.mjs
api/_lib/auth-email.test.mjs
scripts/learn-*.mjs

# Local auth/cache fixtures and policy generation are not website assets.
tests/access-cache/
tools/build-public-assets.mjs

tests/classroom/

# House analytics fixtures and tests are local-only.
tests/house-stats/

# AskSydScience build input and QA are not public website assets.
tools/build-asksydscience.py
tools/asksydscience/
docs/asksydscience/
asksydscience/README.md
